# BasicCycleFlow

main: kit: flow: BasicCycleFlow:
{
  entity: "cycle",
  kind: "basic",
  name: "BasicCycleFlow",
  step: [
    {
      input: {
        ref: "cycle_ref01"
      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "create"
    }

    {
      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "cycle_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "cycle_ref01",
        srcdatavar: "cycle_ref01_data",
        suffix: "_up0",
        textfield: "description"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-cycle_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "cycle_ref01",
        srcdatavar: "cycle_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "cycle01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-cycle_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCycleFlow"
}