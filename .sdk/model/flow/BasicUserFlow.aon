# BasicUserFlow

main: kit: flow: BasicUserFlow:
{
  entity: "user",
  kind: "basic",
  name: "BasicUserFlow",
  step: [
    {
      input: {
        ref: "user_ref01"
      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        include_disabled: "include_disabled01",
        last: "last01",
        order_by: "order_by01",
        service: "service01"
      }

      op: "create"
    }

    {
      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        include_disabled: "include_disabled01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "user_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "user_ref01",
        srcdatavar: "user_ref01_data",
        suffix: "_up0",
        textfield: "avatarBackgroundColor"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-user_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "user_ref01",
        srcdatavar: "user_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-user_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicUserFlow"
}