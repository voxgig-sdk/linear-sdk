# BasicProjectFlow

main: kit: flow: BasicProjectFlow:
{
  entity: "project",
  kind: "basic",
  name: "BasicProjectFlow",
  step: [
    {
      input: {
        ref: "project_ref01"
      }

      match: {
        after: "after01",
        ai_conversation_id: "ai_conversation01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        integration_id: "integration01",
        label_id: "label01",
        last: "last01",
        order_by: "order_by01",
        project_draft_id: "project_draft01",
        project_id: "project01",
        slack_channel_name: "slack_channel_name01",
        sync_source: "sync_source01",
        trash: "trash01"
      }

      op: "create"
    }

    {
      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "project_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "project_ref01",
        srcdatavar: "project_ref01_data",
        suffix: "_up0",
        textfield: "color"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-project_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "project_ref01",
        srcdatavar: "project_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "project01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-project_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "project_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "project01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "project_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProjectFlow"
}