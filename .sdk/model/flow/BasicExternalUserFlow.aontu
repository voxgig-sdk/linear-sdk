# BasicExternalUserFlow

main: kit: flow: BasicExternalUserFlow:
{
  entity: "external_user",
  kind: "basic",
  name: "BasicExternalUserFlow",
  step: [
    {
      m: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "external_user_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "external_user_ref01",
        srcdatavar: "external_user_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "external_user01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-external_user_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicExternalUserFlow"
}