# BasicInitiativeUpdateFlow

main: kit: flow: BasicInitiativeUpdateFlow:
{
  entity: "initiative_update",
  kind: "basic",
  name: "BasicInitiativeUpdateFlow",
  step: [
    {
      input: {
        ref: "initiative_update_ref01"
      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "create"
    }

    {
      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "initiative_update_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "initiative_update_ref01",
        srcdatavar: "initiative_update_ref01_data",
        suffix: "_up0",
        textfield: "body"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-initiative_update_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "initiative_update_ref01",
        srcdatavar: "initiative_update_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "initiative_update01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-initiative_update_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicInitiativeUpdateFlow"
