# BasicEmojiFlow

main: kit: flow: BasicEmojiFlow:
{
  entity: "emoji",
  kind: "basic",
  name: "BasicEmojiFlow",
  step: [
    {
      input: {
        ref: "emoji_ref01"
      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "create"
    }

    {
      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "emoji_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "emoji_ref01",
        srcdatavar: "emoji_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "emoji01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-emoji_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "emoji_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "emoji01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "emoji_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEmojiFlow"
}