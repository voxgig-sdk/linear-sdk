# BasicAccessKeyReleaseFlow

main: kit: flow: BasicAccessKeyReleaseFlow:
{
  entity: "access_key_release",
  kind: "basic",
  name: "BasicAccessKeyReleaseFlow",
  step: [
    {
      input: {
        ref: "access_key_release_ref01"
      }

      match: {
        limit: "limit01"
      }

      op: "create"
    }

    {
      match: {
        limit: "limit01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "access_key_release_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "access_key_release_ref01",
        srcdatavar: "access_key_release_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-access_key_release_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAccessKeyReleaseFlow"
