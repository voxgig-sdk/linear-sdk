# BasicInitiativeFlow

main: kit: flow: BasicInitiativeFlow:
{
  entity: "initiative",
  kind: "basic",
  name: "BasicInitiativeFlow",
  step: [
    {
      input: {
        ref: "initiative_ref01"
      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        label_id: "label01",
        last: "last01",
        lead_team_id: "lead_team01",
        mode: "mode01",
        order_by: "order_by01"
      }

      op: "create"
    }

    {
      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "initiative_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "initiative_ref01",
        srcdatavar: "initiative_ref01_data",
        suffix: "_up0",
        textfield: "color"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-initiative_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "initiative_ref01",
        srcdatavar: "initiative_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "initiative01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-initiative_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "initiative_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "initiative01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "initiative_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicInitiativeFlow"
}