# BasicWorkflowStateFlow

main: kit: flow: BasicWorkflowStateFlow:
{
  entity: "workflow_state",
  kind: "basic",
  name: "BasicWorkflowStateFlow",
  step: [
    {
      input: {
        ref: "workflow_state_ref01"
      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "create"
    }

    {
      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "workflow_state_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "workflow_state_ref01",
        srcdatavar: "workflow_state_ref01_data",
        suffix: "_up0",
        textfield: "color"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-workflow_state_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "workflow_state_ref01",
        srcdatavar: "workflow_state_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "workflow_state01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-workflow_state_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWorkflowStateFlow"
}