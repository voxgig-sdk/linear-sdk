# BasicCommentFlow

main: kit: flow: BasicCommentFlow:
{
  entity: "comment",
  kind: "basic",
  name: "BasicCommentFlow",
  step: [
    {
      i: {
        ref: "comment_ref01"
      }

      m: {
        after: "after01",
        before: "before01",
        first: "first01",
        hash: "hash01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01",
        resolving_comment_id: "resolving_comment01",
        skip_edited_at: "skip_edited_at01"
      }

      o: "create"
    }

    {
      m: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "comment_ref01"
          }
        }
      ]
    }

    {
      d: {
        skip_edited_at: "skip_edited_at01"
      }

      i: {
        ref: "comment_ref01",
        srcdatavar: "comment_ref01_data",
        suffix: "_up0",
        textfield: "body"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-comment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "comment_ref01",
        srcdatavar: "comment_ref01_data",
        suffix: "_dt0"
      }

      m: {
        hash: "hash01",
        id: "comment01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-comment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "comment_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "comment01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "comment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCommentFlow"
}