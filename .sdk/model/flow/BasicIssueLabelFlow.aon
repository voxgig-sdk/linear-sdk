# BasicIssueLabelFlow

main: kit: flow: BasicIssueLabelFlow:
{
  entity: "issue_label",
  kind: "basic",
  name: "BasicIssueLabelFlow",
  step: [
    {
      input: {
        ref: "issue_label_ref01"
      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01",
        replace_team_label: "replace_team_label01"
      }

      op: "create"
    }

    {
      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "issue_label_ref01"
          }
        }
      ]
    }

    {
      data: {
        replace_team_label: "replace_team_label01"
      }

      input: {
        ref: "issue_label_ref01",
        srcdatavar: "issue_label_ref01_data",
        suffix: "_up0",
        textfield: "color"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-issue_label_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "issue_label_ref01",
        srcdatavar: "issue_label_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "issue_label01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-issue_label_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "issue_label_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "issue_label01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "issue_label_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIssueLabelFlow"
}