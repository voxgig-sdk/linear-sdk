# BasicOAuthApplicationFlow

main: kit: flow: BasicOAuthApplicationFlow:
{
  entity: "o_auth_application",
  kind: "basic",
  name: "BasicOAuthApplicationFlow",
  step: [
    {
      input: {
        ref: "o_auth_application_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "o_auth_application_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "o_auth_application_ref01",
        srcdatavar: "o_auth_application_ref01_data",
        suffix: "_up0",
        textfield: "clientId"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-o_auth_application_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "o_auth_application_ref01",
        srcdatavar: "o_auth_application_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "o_auth_application01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-o_auth_application_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOAuthApplicationFlow"
}