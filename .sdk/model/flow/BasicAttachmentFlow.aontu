# BasicAttachmentFlow

main: kit: flow: BasicAttachmentFlow:
{
  entity: "attachment",
  kind: "basic",
  name: "BasicAttachmentFlow",
  step: [
    {
      i: {
        ref: "attachment_ref01"
      }

      m: {
        after: "after01",
        before: "before01",
        channel_id: "channel01",
        conversation_id: "conversation01",
        create_as_user: "create_as_user01",
        display_icon_url: "display_icon_url01",
        first: "first01",
        include_archived: "include_archived01",
        issue_id: "issue01",
        jira_issue_id: "jira_issue01",
        last: "last01",
        link_kind: "link_kind01",
        message_id: "message01",
        number: "number01",
        order_by: "order_by01",
        part_id: "part01",
        project_path_with_namespace: "project_path_with_namespace01",
        sync_to_comment_thread: "sync_to_comment_thread01",
        ticket_id: "ticket01",
        title: "title01",
        url: "url01"
      }

      o: "create"
    }

    {
      m: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "attachment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "attachment_ref01",
        srcdatavar: "attachment_ref01_data",
        suffix: "_up0",
        textfield: "bodyData"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-attachment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "attachment_ref01",
        srcdatavar: "attachment_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "attachment01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-attachment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "attachment_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "attachment01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "attachment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAttachmentFlow"
}