# BasicUsageAlertFlow

main: kit: flow: BasicUsageAlertFlow:
{
  entity: "usage_alert",
  kind: "basic",
  name: "BasicUsageAlertFlow",
  step: [
    {
      m: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "usage_alert_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "usage_alert_ref01",
        srcdatavar: "usage_alert_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "usage_alert01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-usage_alert_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicUsageAlertFlow"
}