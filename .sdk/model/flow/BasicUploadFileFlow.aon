# BasicUploadFileFlow

main: kit: flow: BasicUploadFileFlow:
{
  entity: "upload_file",
  kind: "basic",
  name: "BasicUploadFileFlow",
  step: [
    {
      input: {
        ref: "upload_file_ref01"
      }

      match: {
        content_type: "content_type01",
        filename: "filename01",
        meta_data: "meta_data01",
        size: "size01"
      }

      op: "create"
    }
  ],
  "key$": "BasicUploadFileFlow"
}