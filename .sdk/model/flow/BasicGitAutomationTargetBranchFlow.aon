# BasicGitAutomationTargetBranchFlow

main: kit: flow: BasicGitAutomationTargetBranchFlow:
{
  entity: "git_automation_target_branch",
  kind: "basic",
  name: "BasicGitAutomationTargetBranchFlow",
  step: [
    {
      input: {
        ref: "git_automation_target_branch_ref01"
      }

      op: "create"
    }

    {
      input: {
        ref: "git_automation_target_branch_ref01",
        srcdatavar: "git_automation_target_branch_ref01_data",
        suffix: "_up0",
        textfield: "branchPattern"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-git_automation_target_branch_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "git_automation_target_branch_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "git_automation_target_branch01"
      }

      op: "remove"
    }
  ],
  "key$": "BasicGitAutomationTargetBranchFlow"
}