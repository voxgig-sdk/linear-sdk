# BasicReactionFlow

main: kit: flow: BasicReactionFlow:
{
  entity: "reaction",
  kind: "basic",
  name: "BasicReactionFlow",
  step: [
    {
      input: {
        ref: "reaction_ref01"
      }

      op: "create"
    }

    {
      input: {
        ref: "reaction_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "reaction01"
      }

      op: "remove"
    }
  ],
  "key$": "BasicReactionFlow"
}