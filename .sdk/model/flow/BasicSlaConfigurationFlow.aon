# BasicSlaConfigurationFlow

main: kit: flow: BasicSlaConfigurationFlow:
{
  entity: "sla_configuration",
  kind: "basic",
  name: "BasicSlaConfigurationFlow",
  step: [
    {
      match: {
        team_id: "team01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "sla_configuration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSlaConfigurationFlow"
}