      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "create"
    }

    {
      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "release_stage_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "release_stage_ref01",
        srcdatavar: "release_stage_ref01_data",
