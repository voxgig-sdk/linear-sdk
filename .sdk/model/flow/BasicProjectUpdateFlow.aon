# BasicProjectUpdateFlow

main: kit: flow: BasicProjectUpdateFlow:
{
  entity: "project_update",
  kind: "basic",
  name: "BasicProjectUpdateFlow",
  step: [
    {
      input: {
        ref: "project_update_ref01"
      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01",
        project_id: "project01"
      }

      op: "create"
    }

    {
      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "project_update_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "project_update_ref01",
        srcdatavar: "project_update_ref01_data",
        suffix: "_up0",
        textfield: "body"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-project_update_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "project_update_ref01",
        srcdatavar: "project_update_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "project_update01",
        project_id: "project01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-project_update_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "project_update_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "project_update01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "project_update_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProjectUpdateFlow"
}