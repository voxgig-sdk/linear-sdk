# BasicEmailIntakeAddressFlow

main: kit: flow: BasicEmailIntakeAddressFlow:
{
  entity: "email_intake_address",
  kind: "basic",
  name: "BasicEmailIntakeAddressFlow",
  step: [
    {
      input: {
        ref: "email_intake_address_ref01"
      }

      op: "create"
    }

    {
      input: {
        ref: "email_intake_address_ref01",
        srcdatavar: "email_intake_address_ref01_data",
        suffix: "_up0",
        textfield: "address"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-email_intake_address_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "email_intake_address_ref01",
        srcdatavar: "email_intake_address_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "email_intake_address01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-email_intake_address_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "email_intake_address_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "email_intake_address01"
      }

      op: "remove"
    }
  ],
  "key$": "BasicEmailIntakeAddressFlow"
}