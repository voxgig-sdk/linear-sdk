# BasicCustomViewFlow

main: kit: flow: BasicCustomViewFlow:
{
  entity: "custom_view",
  kind: "basic",
  name: "BasicCustomViewFlow",
  step: [
    {
      i: {
        ref: "custom_view_ref01"
      }

      m: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      o: "create"
    }

    {
      m: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "custom_view_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "custom_view_ref01",
        srcdatavar: "custom_view_ref01_data",
        suffix: "_up0",
        textfield: "color"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-custom_view_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "custom_view_ref01",
        srcdatavar: "custom_view_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "custom_view01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-custom_view_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "custom_view_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "custom_view01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        after: "after01",
        before: "before01",
        first: "first01",
        include_archived: "include_archived01",
        last: "last01",
        order_by: "order_by01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "custom_view_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCustomViewFlow"
}