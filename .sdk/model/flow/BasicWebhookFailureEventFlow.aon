# BasicWebhookFailureEventFlow

main: kit: flow: BasicWebhookFailureEventFlow:
{
  entity: "webhook_failure_event",
  kind: "basic",
  name: "BasicWebhookFailureEventFlow",
  step: [
    {
      match: {
        webhook_id: "webhook01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "webhook_failure_event_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWebhookFailureEventFlow"
}